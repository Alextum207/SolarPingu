# Solar Lead OS - Agent 2 local config
ENVIRONMENT=local

# Demo-safe defaults. Set both to false when real Google APIs are enabled.
USE_MOCK_GEOCODING=true
USE_MOCK_SOLAR=true

# Leave blank for fallback mode. The same Google Maps Platform key can often be
# used for both Geocoding API and Solar API if both APIs are enabled.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_SOLAR_API_KEY=
GOOGLE_MAPS_STATIC_API_KEY=
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
FEATHERLESS_API_KEY=
AGENT1_WEBHOOK_URL=http://127.0.0.1:8000/api/finder/leads

# Gemini REST model. The service falls back to deterministic rules if this fails.
GEMINI_MODEL=gemini-2.5-flash
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_VISION_MODEL=google/gemma-3-27b-it

# External API safety.
EXTERNAL_API_TIMEOUT_SECONDS=8

# Solar economics assumptions for German SMB installer demos.
ELECTRICITY_PRICE_PER_KWH=0.34
FEED_IN_TARIFF_PER_KWH=0.08
SELF_CONSUMPTION_RATIO=0.55
BASE_PRICE_PER_KWP_MIN=1580
BASE_PRICE_PER_KWP_MAX=2040
BATTERY_ADDON_PRICE_MIN=2500
BATTERY_ADDON_PRICE_MAX=3000

# Local Google Maps Static satellite image proxy settings.
GOOGLE_MAPS_STATIC_ZOOM=20
GOOGLE_MAPS_STATIC_SIZE=640x360
GOOGLE_MAPS_STATIC_SCALE=2

# Finder Agent demo defaults and limits.
USE_MOCK_PLACES=true
FINDER_MAX_PLACES_PER_RUN=30
AGENT1_WEBHOOK_MAX_ATTEMPTS=2
